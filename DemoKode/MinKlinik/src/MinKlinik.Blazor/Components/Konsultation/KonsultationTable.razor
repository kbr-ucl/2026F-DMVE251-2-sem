@if (Konsultationer.Count == 0)
{
    <p>(ingen)</p>
}
else
{
    <section>
        <table class="table table-striped">
            <caption>@Caption</caption>
            <thead>
                <tr>
                    <th scope="col">Fra</th>
                    <th scope="col">Til</th>
                    <th scope="col">Patient</th>
                    <th scope="col">Behandler</th>
                    <th scope="col">Behandlingstype</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var konsultation in Konsultationer)
                {
                    <tr>
                        <td>@konsultation.Fra.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@konsultation.Til.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@konsultation.PatientNavn</td>
                        <td>@konsultation.BehandlerNavn</td>
                        <td>@konsultation.BehandlingstypeNavn</td>
                        <td>@konsultation.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<KonsultationDto> Konsultationer { get; set; } = [];

    [Parameter]
    public string Caption { get; set; } = "Konsultationer";
}
